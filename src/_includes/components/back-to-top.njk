<button class="top-button" id="back-to-top" aria-label="Back to top" title="Back to top">↑</button>

<style>
    .top-button {
        width: 2.5rem;
        height: 2.5rem;
        background: transparent;
        border: 1px solid var(--mid);
        border-radius: 50%;
        font-size: 1.125rem;
        line-height: 1;
        color: var(--mid);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.8;
    }

    #back-to-top {
        position: fixed;
        bottom: 6.4rem;
        right: 2rem;
        display: none;
        cursor: pointer;
        z-index: 999;
    }

    #back-to-top.visible {
        display: block;
    }

    @media (max-width: 600px) {
        #back-to-top { bottom: 8.2rem; right: 1.5rem; }
    }
</style>

<script>
    const btn = document.getElementById('back-to-top');

    window.addEventListener('scroll', () => {
        btn.classList.toggle('visible', window.scrollY > 300);
    });

    btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>